[Unit]
Description=derecord — sinalização e app
After=network.target

[Service]
Type=simple
User=derecord
WorkingDirectory=/opt/derecord
EnvironmentFile=/etc/derecord.env
ExecStart=/usr/bin/node /opt/derecord/server.js
Restart=always
RestartSec=3

# O processo só precisa escrever em uploads/.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/derecord/uploads

[Install]
WantedBy=multi-user.target
